NODE_ENV=production
# Vercel cron auth (any long random string). Vercel sends it automatically as a Bearer token to /api/cron.
CRON_SECRET=PASTE_OUTPUT_OF__openssl rand -hex 32
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orderistan?retryWrites=true&w=majority
# Generate each secret yourself:  openssl rand -base64 48
JWT_SECRET=PASTE_OUTPUT_OF__openssl rand -base64 48
JWT_EXPIRES_IN=7d
# Owner/admin sessions are short on purpose
ADMIN_JWT_EXPIRES_IN=2h
# Cloudinary: Console > Settings > API Keys. Keep this server-side only.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
ROOT_DOMAIN=orderistan.site
# Public company inbox: shown on the site, used as Reply-To on every email we send.
SUPPORT_EMAIL=orderistan@gmail.com
# Proxy hops in front of Node: 1 = nginx only, 2 = Cloudflare -> nginx -> Node.
# IMPORTANT: if you use Cloudflare and leave this at 1, every visitor looks like one IP. Set 2 and check the startup log line "trust proxy=".
TRUST_PROXY=1   # Vercel = 1 hop
# bcrypt cost for NEW passwords (10-14). 10 is ~80ms with the native `bcrypt` module; existing hashes keep working.
BCRYPT_COST=10
# DNS used for MongoDB Atlas lookups (default 8.8.8.8,1.1.1.1). Use "system" to use the server's own resolver.
# DNS_SERVERS=system
# Extra allowed browser origins (comma separated). orderistan.site and *.orderistan.site are always allowed.
# REQUIRED for your Cloudflare frontend (exact origin, no trailing slash):
ALLOWED_ORIGINS=https://orderistan-complete.nasirsaeed6767.workers.dev

# Owner (admin) account - used ONLY for first-time creation or `npm run reset-admin`.
# Use a private, non-guessable email and a strong password (12+ chars, upper+lower+number+symbol).
# The server refuses weak/default passwords. Remove ADMIN_PASSWORD from this file after it has been applied.
ADMIN_NAME=Orderistan Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- E-mail (Brevo) for sign-up verification codes, password-reset codes and security alerts ---
# Brevo > SMTP & API > API Keys. Keep it server-side only; never commit it or put it in the frontend.
# BREVO_SENDER_EMAIL must be a sender you verified in Brevo > Senders, Domains & Dedicated IPs.
# Without these two the server still starts, but sign-up and password reset cannot send codes (in development the code is printed in the console).
BREVO_API_KEY=PASTE_YOUR_SAVED_KEY
# TIP: Gmail addresses are poor senders (Gmail/Brevo DMARC rules can send mail to spam or reject it). Verify your domain in Brevo and use
# e.g. noreply@orderistan.site here; customer replies still go to SUPPORT_EMAIL (orderistan@gmail.com) through Reply-To.
BREVO_SENDER_EMAIL=your_verified_sender_email
BREVO_SENDER_NAME=Orderistan

# Free trial days given to new seller signups (0 = wait for admin activation)
TRIAL_DAYS=0

# MongoDB storage limit used by the admin System Overview (MB). This is a CONFIGURED threshold, not read from Atlas. Free tier (M0) = 512; change it if you upgrade the cluster.
# DB_CAPACITY_MB=512
# Time zone used for "today" / "this month" in the admin e-mail counters (default Asia/Karachi).
# STATS_TIMEZONE=Asia/Karachi

# --- Optional ---
# Store time zone offset in hours from UTC, used for service-booking slots (Pakistan = 5).
# STORE_TZ_HOURS=5
# Number of pm2 cluster workers (default: one per CPU core).
# WEB_CONCURRENCY=2
